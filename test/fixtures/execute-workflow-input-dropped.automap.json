[
  {
    "name": "Parent - Shipment Intake",
    "nodes": [
      {
        "name": "Execute Sub-Workflow",
        "type": "n8n-nodes-base.executeWorkflow",
        "typeVersion": 1.3,
        "parameters": {
          "source": "database",
          "workflowId": { "value": "child-fields-4", "mode": "id" },
          "workflowInputs": {
            "mappingMode": "autoMapInputData",
            "value": {
              "shipmentId": "={{ $json.shipmentId }}",
              "carrier": "={{ $json.carrier }}"
            },
            "schema": []
          }
        }
      }
    ],
    "connections": {}
  },
  {
    "id": "child-fields-4",
    "name": "Child - Notify Carrier",
    "nodes": [
      {
        "name": "When Executed by Another Workflow",
        "type": "n8n-nodes-base.executeWorkflowTrigger",
        "typeVersion": 1.1,
        "parameters": {
          "inputSource": "workflowInputs",
          "workflowInputs": {
            "values": [{ "name": "shipmentId", "type": "string" }]
          }
        }
      }
    ],
    "connections": {}
  }
]
