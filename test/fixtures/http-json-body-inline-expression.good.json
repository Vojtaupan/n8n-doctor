{
  "name": "HTTP JSON body wrapped in one expression",
  "nodes": [
    {
      "name": "Create User",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "https://api.example.com/users",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ userId: $json.id, name: $json.name }) }}"
      }
    }
  ],
  "connections": {}
}
