{
  "name": "HTTP append building its body with a single-quoted expression",
  "nodes": [
    {
      "name": "Append Via API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "https://sheets.googleapis.com/v4/spreadsheets/spreadsheet-id-placeholder/values:batchUpdate",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ valueInputOption: 'USER_ENTERED', data: [{ range: 'Sheet1!A1', values: [[$json.phone]] }] }) }}"
      }
    }
  ],
  "connections": {}
}
