{
  "name": "HTTP append to the Sheets API with USER_ENTERED in the query",
  "nodes": [
    {
      "name": "Append Via API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "https://sheets.googleapis.com/v4/spreadsheets/spreadsheet-id-placeholder/values/Sheet1!A:D:append?valueInputOption=USER_ENTERED&insertDataOption=INSERT_ROWS",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"values\": [[{{ JSON.stringify($json.phone) }}]]}"
      }
    }
  ],
  "connections": {}
}
