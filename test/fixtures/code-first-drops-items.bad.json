{
  "name": "Code first() drops items",
  "nodes": [
    {
      "name": "Split Out Rows",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "parameters": { "fieldToSplitOut": "rows" }
    },
    {
      "name": "Process Row",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const row = $input.first().json;\nreturn [{ json: { id: row.id } }];"
      }
    }
  ],
  "connections": {
    "Split Out Rows": {
      "main": [[{ "node": "Process Row", "type": "main", "index": 0 }]]
    }
  }
}
